<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NusaTrainer.App.ViewModels"
        xmlns:v="using:NusaTrainer.App.Views"
        x:Class="NusaTrainer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NusaTrainer"
        Icon="/Assets/nusatrainer.ico"
        Width="1240" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
  <Panel>
    <Grid ColumnDefinitions="290,*">
      <!-- ============ Sidebar ============ -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="20,22,20,8" Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Image Source="/Assets/nusatrainer.png" Width="38" Height="38"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NusaTrainer" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Cheat &amp; mod game single-player" Classes="muted" FontSize="11"/>
              </StackPanel>
            </StackPanel>
            <TextBox Watermark="🔍  Cari game…" Text="{Binding SearchText}"/>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding DatabaseInfo}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,8,Auto">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding UpdateDatabaseCommand}" ToolTip.Tip="Ambil cheat &amp; mod terbaru dari server">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⟳"/>
                    <TextBlock Text="Perbarui database"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="⚙" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Pengaturan" Width="40"/>
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsUpdating}" Height="3" MinHeight="3"/>
              <TextBlock Text="{Binding AppVersionText}" Classes="muted" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}"/>
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Top" Text="PUSTAKA GAME" Classes="section" Margin="22,10,20,6"/>
          <ListBox Classes="games" ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame}"
                   Background="Transparent" Margin="10,0,10,8">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GameViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="38" Height="38" CornerRadius="9" Background="{Binding AccentBrush}">
                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11"/>
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding StatusBrush}" IsVisible="{Binding IsRunning}"
                           ToolTip.Tip="{Binding StatusText}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ============ Konten ============ -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
          <Border Background="#172554" BorderBrush="#1E40AF" BorderThickness="0,0,0,1" Padding="20,10" IsVisible="{Binding AppUpdateAvailable}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="⬆" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding AppUpdateText}" TextWrapping="Wrap"/>
                <ProgressBar Value="{Binding AppUpdateProgress}" Maximum="100" Height="3" MinHeight="3"/>
              </StackPanel>
              <Button Grid.Column="2" Classes="accent" Content="Perbarui &amp; mulai ulang" Command="{Binding InstallAppUpdateCommand}" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <Border Background="#451A03" BorderBrush="#92400E" BorderThickness="0,0,0,1" Padding="20,10" IsVisible="{Binding !IsElevated}">
            <TextBlock TextWrapping="Wrap" Text="⚠  NusaTrainer tidak berjalan sebagai Administrator. Banyak game tidak bisa dihubungkan tanpa hak Administrator — klik kanan → Run as administrator."/>
          </Border>
        </StackPanel>

        <Panel Grid.Row="1">
          <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="🎮" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Pilih game dari pustaka" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Atau jalankan game — NusaTrainer akan mendeteksinya otomatis." Classes="muted" HorizontalAlignment="Center"/>
          </StackPanel>
          <ContentControl Content="{Binding SelectedGame}" IsVisible="{Binding HasSelection}">
            <ContentControl.DataTemplates>
              <DataTemplate x:DataType="vm:GameViewModel">
                <v:GameView/>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Panel>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
          <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </Grid>

    <!-- ============ Pengaturan (overlay) ============ -->
    <Border Background="#B3000000" IsVisible="{Binding IsSettingsOpen}">
      <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Background="#161A23"
              DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
        <StackPanel Spacing="14">
          <TextBlock Text="Pengaturan" FontSize="22" FontWeight="Bold"/>
          <StackPanel Spacing="6">
            <TextBlock Text="URL database (folder berisi index.json)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding DatabaseUrl}" Watermark="https://username.github.io/NusaTrainer/"/>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Public key tanda tangan database (PEM)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PublicKeyPem}" AcceptsReturn="True" Height="120" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                     Watermark="-----BEGIN PUBLIC KEY-----&#x0a;…&#x0a;-----END PUBLIC KEY-----" TextWrapping="NoWrap"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Database yang tidak ditandatangani dengan kunci ini akan ditolak, sehingga cheat/mod palsu tidak bisa disusupkan."/>
          </StackPanel>
          <CheckBox IsChecked="{Binding RequireSignature}" Content="Wajib tanda tangan (disarankan)"/>
          <CheckBox IsChecked="{Binding AutoUpdateOnStart}" Content="Perbarui database otomatis saat aplikasi dibuka dan berkala"/>
          <CheckBox IsChecked="{Binding CheckAppUpdates}" Content="Beri tahu bila ada versi aplikasi baru"/>
          <TextBlock Classes="muted" TextWrapping="Wrap">
            <Run Text="Folder data: "/><Run Text="{Binding DataFolder}"/>
          </TextBlock>
          <TextBlock Text="{Binding Error}" Foreground="#F87171" IsVisible="{Binding HasError}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Batal" Command="{Binding CancelCommand}"/>
            <Button Classes="accent" Content="Simpan" Command="{Binding SaveCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
