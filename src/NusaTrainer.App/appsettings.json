{
  // URL folder database (berisi index.json). Ganti USERNAME dengan akun GitHub Anda
  // setelah mengaktifkan GitHub Pages (lihat docs/DATABASE.md).
  "databaseUrl": "https://USERNAME.github.io/NusaTrainer/",
  // Isi dengan public.pem hasil 'nusa-db keygen'. Kosong = pembaruan online ditolak bila requireSignature=true.
